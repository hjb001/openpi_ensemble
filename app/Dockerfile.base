# 赛方要求：容器内推理监听 8999；docker run 无需再跟命令（用 CMD 自启动）。
# 基于 acot-icra-25k checkpoint，照搬 baseline 推理模式（无 TTS、无 partial execution）。
# 构建上下文必须是本目录（含 checkpoints、uv.lock 等）：
#   cd /data/openpi_app/app
#   docker build -f Dockerfile.base -t openpi-g2sim:base .
# docker tag openpi-g2sim:base sim-icra-registry.cn-beijing.cr.aliyuncs.com/aether/openpi-g2sim:base
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    OPENPI_DATA_HOME=/app/.cache/openpi \
    XLA_FLAGS=--xla_gpu_enable_triton_gemm=false \
    MPLBACKEND=Agg

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    curl \
    ca-certificates \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY . .

RUN mkdir -p /app/.cache/openpi \
    && uv sync --frozen --no-dev \
    && uv pip install "matplotlib>=3.10.0"

EXPOSE 8999

# G2SIM 权重：./checkpoints/...（见 scripts/serve_policy.py）；TTS 用布尔标志 --tts，勿写裸 tts（会被当成 policy 子命令）
CMD ["/app/.venv/bin/python", "scripts/serve_policy.py", "--env", "G2SIM", "--port", "8999", "--tts"]
